{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Debate",
  "version": "0.1.2",
  "identifier": "com.hanminlim.aidebate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "토론 무대",
        "width": 1400,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QjgyQjIzOUVFMDI3NDcKUldSSEorQ2VJeXU0bFl2R08wdUJaVnZPNzA0OSt6aWZUZ1dLK01jaTdYRWRoQU9uUC8xc0cxZTcK",
      "endpoints": [
        "https://github.com/hanminlim/ai-debate/releases/latest/download/latest.json"
      ]
    }
  }
}
